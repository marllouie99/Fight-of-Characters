{
  "name": "fight-of-larpers-101",
  "version": "1.0.0",
  "type": "module",
  "description": "Fight of Larpers 101 - Mini-Battle arena designed for 9:16 OBS capture and Electron desktop app",
  "main": "electron-main.js",
  "scripts": {
    "start": "node scripts/runRustDesktop.mjs",
    "start:rust": "node scripts/runRustDesktop.mjs",
    "start:electron": "electron .",
    "build:rust": "node scripts/runRustDesktop.mjs --build-only",
    "start:web": "node scripts/buildMobileAssets.mjs && serve -l 8000 .",
    "preview": "serve -l 8000 .",
    "postinstall": "node scripts/buildMobileAssets.mjs",
    "verify": "node scripts/verifyCodebase.js",
    "test": "node scripts/testAllFighters.mjs",
    "test:tag": "node scripts/testTagMatch.mjs",
    "test:interactions": "node scripts/testInteractions.mjs",
    "bench:combat": "node scripts/benchmarkCombat.mjs",
    "bench:combat:all": "node scripts/benchmarkCombat.mjs --all",
    "bench:gate": "node --expose-gc --max-semi-space-size=128 scripts/benchmarkCombat.mjs --all --ticks=300 --warmup=60 --gate --max-avg=6.0 --max-p99=35.0",
    "scaffold:fighter": "node scripts/scaffoldFighter.mjs",
    "scaffold:boss": "node scripts/scaffoldBossConfig.mjs",
    "patch-notes": "node scripts/generatePatchNotes.mjs",
    "catalog": "node scripts/buildAssetCatalog.mjs",
    "build:sound-sprite": "node scripts/buildAudioSprite.mjs",
    "build:voicesprite": "node scripts/buildAudioSprite.mjs --voice-only",
    "build:voice-sprite": "node scripts/buildAudioSprite.mjs --voice-only",
    "build:web": "node scripts/buildWeb.mjs",
    "build:mobile-assets": "node scripts/buildMobileAssets.mjs",
    "preview:web": "serve -l 8000 dist",
    "mobile:sync": "npm run build:web -- --skip-zip && npx cap sync && node scripts/buildMobileAssets.mjs --prune-android",
    "mobile:apk": "npm run mobile:sync && cd android && gradlew.bat assembleDebug && cd .. && node -e \"import('fs').then(fs => fs.copyFileSync('android/app/build/outputs/apk/debug/app-debug.apk', 'dist/Fight-of-Characters-Mobile.apk'))\"",
    "mobile:bundle": "npm run mobile:sync && cd android && gradlew.bat bundleDebug && cd .. && node -e \"import('fs').then(fs => fs.copyFileSync('android/app/build/outputs/bundle/debug/app-debug.aab', 'dist/Fight-of-Characters-Mobile.aab'))\"",
    "mobile:bundle:release": "npm run mobile:sync && cd android && gradlew.bat bundleRelease && cd .. && node -e \"import('fs').then(fs => { const d = 'android/app/build/outputs/bundle/release'; const f = fs.readdirSync(d).find(x => x.endsWith('.aab')); if (f) fs.copyFileSync(d + '/' + f, 'dist/Fight-of-Characters-Mobile-release.aab'); })\"",
    "mobile:run": "node scripts/deployMobile.mjs --build",
    "mobile:install": "node scripts/deployMobile.mjs",
    "mobile:open:ios": "npx cap open ios",
    "mobile:open:android": "npx cap open android",
    "release:tag": "node scripts/createReleaseTag.mjs",
    "server:py": "python scripts/server.py",
    "build": "electron-builder --win"
  },
  "author": "",
  "license": "ISC",
  "build": {
    "appId": "com.fightoflarpers101.app",
    "productName": "Fight of Larpers 101",
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "directories": {
      "output": "dist"
    }
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "ffmpeg-static": "^5.3.0",
    "javascript-obfuscator": "^5.9.0",
    "sharp": "^0.35.5"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/screen-orientation": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "pixi.js": "^7.3.2",
    "serve": "^14.2.1"
  }
}
